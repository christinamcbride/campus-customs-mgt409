# ---- Assignment data: never commit ----
data/
!data/.gitkeep
*.db
*.sqlite
*.sqlite3

# ---- Secrets ----
# Match any env file anywhere, including names like PORTKEY_API_KEY.env,
# so a key file cannot be committed by having an unexpected name.
.env
*.env
.env.*
**/*.env
!.env.example
!backend/.env.example
*.pem
*.key
*secret*
!**/security.py

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Node ----
node_modules/
dist/
dist-ssr/
*.local
.vite/

# ---- Editors / OS ----
.DS_Store
.idea/
.vscode/
*.swp
