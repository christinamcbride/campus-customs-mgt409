# Copy to backend/.env and fill in. Never commit the real .env.

# Auth header for the AI gateway. Graders: your own key goes here.
PORTKEY_API_KEY=

# OpenAI-compatible gateway the agent calls.
AI_BASE_URL=https://api.portkey.ai/v1
AI_MODEL=gpt-4o-mini

# Secret used to sign session tokens. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=

# Set true when serving over HTTPS, so the session cookie is HTTPS-only.
COOKIE_SECURE=false

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
