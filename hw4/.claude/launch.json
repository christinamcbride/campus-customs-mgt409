{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "campus-customs-backend",
      "runtimeExecutable": "../.venv/bin/python",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "port": 8000,
      "cwd": "backend"
    },
    {
      "name": "campus-customs-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5174
    }
  ]
}
